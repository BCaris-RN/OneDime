{
  "name": "onedime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json && esbuild public/app.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "build:server": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
