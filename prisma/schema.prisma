//  (o) OneDime | prisma/schema.prisma
//  ----------------------------------------------------------
//  Identity, game and private feedback models. Workspace SQL constraints live in migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  smartSuggestions Boolean @default(false) @map("smart_suggestions")
  id           String          @id @default(uuid()) @db.Uuid
  paypalUserId String          @unique @map("paypal_user_id")
  displayName  String?         @map("display_name")
  paypalVerified Boolean? @map("paypal_verified")
  email        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  lastSeenAt   DateTime        @default(now()) @map("last_seen_at")
  leaderboardOptIn Boolean    @default(false) @map("leaderboard_opt_in")
  timeZone     String?         @map("time_zone")
  clockPlatform String?        @map("clock_platform")
  clockStartedAt DateTime?     @map("clock_started_at") @db.Timestamptz
  welcomeCompletedAt DateTime? @map("welcome_completed_at") @db.Timestamptz
  logEntries   LogEntry[]
  payouts      Payout[]
  questProgress QuestProgress[]
  receipts     Receipt[]
  rungClaims   RungClaim[]
  sessions     Session[]
  feedback     Feedback[]
  professionRankClaims ProfessionRankClaim[]

  @@map("players")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  app       String
  body      String   @db.VarChar(1000)
  blocking  Boolean  @default(false)
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("feedback")
}

model Session {
  id        String   @id
  playerId  String   @map("player_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([expiresAt])
  @@map("sessions")
}

model OauthState {
  state     String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

model LogEntry {
  id          String    @id @default(uuid()) @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  platform    String
  amountCents Int       @map("amount_cents")
  minutes     Int
  workedOn    DateTime  @map("worked_on") @db.Date
  note        String?
  verificationSource String? @map("verification_source")
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  receipts    Receipt[]

  @@index([playerId])
  @@index([workedOn])
  @@map("log_entries")
}

model QuestProgress {
  playerId    String   @map("player_id") @db.Uuid
  questId     String   @map("quest_id")
  completedAt DateTime @default(now()) @map("completed_at")
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, questId])
  @@map("quest_progress")
}

model RungClaim {
  rungCents Int      @map("rung_cents")
  playerId   String   @map("player_id") @db.Uuid
  claimedAt  DateTime @default(now()) @map("claimed_at")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, rungCents])
  @@index([playerId])
  @@map("rung_claims")
}

model ProfessionRankClaim {
  playerId   String   @map("player_id") @db.Uuid
  profession String
  rank       Int
  claimedAt  DateTime @default(now()) @map("claimed_at") @db.Timestamptz
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, profession, rank])
  @@index([playerId])
  @@map("profession_rank_claims")
}

model Receipt {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @map("player_id") @db.Uuid
  logEntryId    String?   @map("log_entry_id") @db.Uuid
  status        String
  extractedJson Json?     @map("extracted_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  logEntry      LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: SetNull)
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([logEntryId])
  @@map("receipts")
}

model Payout {
  id            String   @id @default(uuid()) @db.Uuid
  playerId      String   @map("player_id") @db.Uuid
  rungCents     Int      @map("rung_cents")
  recipientEmail String? @map("recipient_email")
  senderBatchId String? @unique @map("sender_batch_id")
  amountCents Int? @map("amount_cents")
  attemptStartedAt DateTime? @map("attempt_started_at") @db.Timestamptz
  firstAttemptAt DateTime? @map("first_attempt_at") @db.Timestamptz
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz
  paypalBatchId String?  @map("paypal_batch_id")
  batchStatus   String?  @map("batch_status")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([rungCents])
  @@unique([playerId, rungCents], map: "payouts_player_rung_key")
  @@map("payouts")
}
