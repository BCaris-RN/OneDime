{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow run *)",
      "Bash(gh release create *)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method DELETE*)"
    ]
  }
}
